# Copia este archivo a .env y rellena tu token real (NO subas .env al repo).
# Regístrate y obtén el token de 64 caracteres en:
# https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=pon_aqui_tu_token_de_64_caracteres

# Opcionales (valores por defecto en config.py):
# BANXICO_BASE_URL=https://www.banxico.org.mx/SieAPIRest/service/v1
# REQUEST_TIMEOUT_SECONDS=10
# CACHE_TTL_SECONDS=300
# LOG_LEVEL=INFO
